# ==============================================================================
# Bankindon · configuración de entorno
# ==============================================================================
# Copia este archivo a `.env` y completa los valores. `.env` NUNCA se versiona.
# Toda la configuración se valida al arrancar (server/src/config.ts): si falta
# algo obligatorio, el proceso falla de inmediato con un mensaje claro en lugar
# de arrancar a medias.
# ==============================================================================

# --- Servidor -----------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Origen exacto del frontend, SIN barra final. Se usa para CORS y para validar
# el encabezado Origin en las peticiones que modifican datos (protección CSRF).
WEB_ORIGIN=http://localhost:5173

# En producción con TLS terminado en un proxy: true.
# Si el proxy está en una red concreta: lista de subredes separadas por comas.
TRUST_PROXY=false

# --- Secretos -----------------------------------------------------------------
# OBLIGATORIO. Firma las sesiones (JWT). Mínimo 32 caracteres.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# OBLIGATORIO en producción. Cifra los documentos de identidad (AES-256-GCM).
# Debe ser DISTINTA de APP_SECRET: así rotar la firma de sesiones no deja
# ilegibles los documentos ya guardados. Si se omite, se reutiliza APP_SECRET
# (compatible con instalaciones antiguas, pero se emite un aviso al arrancar).
DOCUMENT_KEY=

# --- Sesión -------------------------------------------------------------------
# Duración de la sesión en horas (1-168).
SESSION_TTL_HOURS=8
# `true` exige HTTPS para enviar la cookie. En producción debe ser true.
# Si se omite, se deduce de NODE_ENV.
COOKIE_SECURE=

# --- Base de datos (MySQL 8 / MariaDB con InnoDB) -----------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bankindon
DB_USER=bankindon
DB_PASSWORD=
# Conexiones simultáneas. Mínimo 2 (el devengo reserva una para su lock).
# Regla práctica: DB_POOL_SIZE × nº de instancias < max_connections de MySQL.
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000

# --- Devengo de intereses -----------------------------------------------------
ACCRUAL_ENABLED=true
ACCRUAL_INTERVAL_MINUTES=15
ACCRUAL_RUN_ON_BOOT=true

# --- Seguridad de acceso ------------------------------------------------------
# Intentos fallidos por cuenta antes de bloquearla temporalmente.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Límite global por IP (el login tiene además su propio límite).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# --- Observabilidad -----------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ==============================================================================
# Administrador inicial (solo para `npm run db:bootstrap-admin`)
# ==============================================================================
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ==============================================================================
# Docker Compose (solo si usas docker-compose.yml)
# ==============================================================================
# Contraseña de root de MySQL en el contenedor.
DB_ROOT_PASSWORD=
# Puerto público del contenedor de la aplicación.
APP_PORT=4000

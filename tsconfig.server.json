{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "outDir": "server/dist",
    "rootDir": "server/src", "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, "noFallthroughCasesInSwitch": true,
    "types": ["node"], "resolveJsonModule": true
  },
  "include": ["server/src/**/*.ts"]
}
